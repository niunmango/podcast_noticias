# Python Virtual Environment
venv/
.venv/
env/

# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class

# Logs & Temporary files
*.log
.DS_Store
.env
.env.local

# Audio and script artifacts (keep directory structure)
output/audio/*.wav
output/audio/*.mp3
output/scripts/*.txt
output/scripts/*.md
output/covers/*.jpg
output/metadata/*.txt
output/metadata/*.json
!output/audio/.gitkeep
!output/scripts/.gitkeep
!output/covers/.gitkeep
!output/metadata/.gitkeep
